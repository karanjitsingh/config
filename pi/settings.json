{
  "mcpServers": {
    "codegraph": {
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ]
    }
  },

  "lastChangelogVersion": "0.85.1",
  "theme": "tailwind-night",
  "defaultProvider": "zai",
  "defaultModel": "glm-5.3",
  "defaultThinkingLevel": "high",
  "terminal": {
    "showTerminalProgress": true
  },
  "ayu": {
    "checkpoint": {
      "exclude": [
        ".pi/",
        ".pi/**"
      ]
    }
  }
}