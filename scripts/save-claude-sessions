#!/usr/bin/env python3
"""Scan every tmux pane for a running `claude` process and record its
session id, so sessions can be restored later with `claude --resume <id>`.

Usage: save-claude-sessions [-o OUT] [-v]

A claude process doesn't expose its session id directly, so each pane is
resolved through three fallbacks, most trustworthy first:

  1. Live fd scan: while a background tool is running, claude keeps a fd
     open under /tmp/claude-<uid>/<project-dir>/<session-id>/, which
     names the id outright.
  2. tmux-resurrect's last save file, which records the literal
     `claude --resume <id>` command used to launch the pane (only useful
     if the pane was itself started that way).
  3. The project's scratchpad dir under /tmp/claude-<uid>/<project-dir>/:
     if exactly one session dir exists there, it's an unambiguous match.

A pane that resolves by none of these is written with an empty session
id and reported on stderr instead of guessed.
"""
import argparse
import csv
import os
import re
import subprocess
import sys
from pathlib import Path

RESUME_RE = re.compile(r"--resume[= ]([0-9a-f-]{36})")
RESURRECT_DIR = Path.home() / ".local/share/tmux/resurrect"
CLAUDE_TMP_ROOT = Path(f"/tmp/claude-{os.getuid()}")


def sh(cmd):
    return subprocess.run(cmd, capture_output=True, text=True, check=True).stdout


def project_dir_name(path):
    """Mirror Claude Code's own encoding of a cwd into a /tmp project dir name."""
    return re.sub(r"[^A-Za-z0-9]", "-", path)


def list_panes():
    fmt = "\t".join(
        "#{session_name} #{window_index} #{window_name} #{pane_index} "
        "#{pane_pid} #{pane_current_command} #{pane_current_path}".split()
    )
    out = sh(["tmux", "list-panes", "-a", "-F", fmt])
    panes = []
    for line in out.splitlines():
        session, window, wname, pane, pid, cmd, path = line.split("\t")
        panes.append(
            dict(
                session=session,
                window=window,
                wname=wname,
                pane=pane,
                pid=int(pid),
                cmd=cmd,
                path=path,
            )
        )
    return panes


def find_claude_descendant(pid):
    """BFS down the process tree from pid for the first process named 'claude'."""
    frontier = [pid]
    seen = set()
    while frontier:
        next_frontier = []
        for p in frontier:
            comm_file = Path(f"/proc/{p}/comm")
            try:
                comm = comm_file.read_text().strip()
            except OSError:
                continue
            if comm == "claude":
                return p
            try:
                children = Path(f"/proc/{p}/task/{p}/children").read_text().split()
            except OSError:
                children = []
            for c in children:
                c = int(c)
                if c not in seen:
                    seen.add(c)
                    next_frontier.append(c)
        frontier = next_frontier
    return None


def fd_session_id(pid):
    """Look for an open fd under /tmp/claude-<uid>/<project>/<session-id>/..."""
    fd_dir = Path(f"/proc/{pid}/fd")
    try:
        entries = list(fd_dir.iterdir())
    except OSError:
        return None
    for entry in entries:
        try:
            target = os.readlink(entry)
        except OSError:
            continue
        m = re.match(rf"{re.escape(str(CLAUDE_TMP_ROOT))}/[^/]+/([0-9a-f-]{{36}})/", target)
        if m:
            return m.group(1)
    return None


def latest_resurrect_file():
    link = RESURRECT_DIR / "last"
    if link.exists():
        return link.resolve()
    files = sorted(RESURRECT_DIR.glob("tmux_resurrect_*.txt"))
    return files[-1] if files else None


def load_resurrect_ids():
    """Map (session, window_index) -> resumed session id, from the last tmux-resurrect save."""
    path = latest_resurrect_file()
    if not path:
        return {}
    ids = {}
    for line in path.read_text().splitlines():
        if not line.startswith("pane\t"):
            continue
        fields = line.split("\t")
        if len(fields) < 4:
            continue
        _, session, window = fields[0], fields[1], fields[2]
        m = RESUME_RE.search(line)
        if m:
            ids[(session, window)] = m.group(1)
    return ids


def unique_scratchpad_id(path):
    """If exactly one session dir exists for this cwd's project, return its id."""
    proj_dir = CLAUDE_TMP_ROOT / project_dir_name(path)
    if not proj_dir.is_dir():
        return None, []
    candidates = [p.name for p in proj_dir.iterdir() if p.is_dir()]
    if len(candidates) == 1:
        return candidates[0], candidates
    return None, candidates


def transcript_exists(session_id, path):
    proj = re.sub(r"[^A-Za-z0-9]", "-", path)
    return (Path.home() / ".claude/projects" / proj / f"{session_id}.jsonl").exists()


def resolve(pane, resurrect_ids):
    claude_pid = find_claude_descendant(pane["pid"])
    if claude_pid is None:
        return None, "no claude process found under pane"

    sid = fd_session_id(claude_pid)
    if sid:
        return sid, "live fd"

    sid = resurrect_ids.get((pane["session"], pane["window"]))
    if sid and transcript_exists(sid, pane["path"]):
        return sid, "tmux-resurrect"

    sid, candidates = unique_scratchpad_id(pane["path"])
    if sid:
        return sid, "unique scratchpad dir"

    if candidates:
        return None, f"ambiguous: {len(candidates)} scratchpad dirs, no unique match"
    return None, "no scratchpad dir, no resurrect record"


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("-o", "--out", default=str(Path.home() / "claude_sessions.csv"))
    ap.add_argument("-v", "--verbose", action="store_true")
    args = ap.parse_args()

    resurrect_ids = load_resurrect_ids()
    rows = []
    for pane in list_panes():
        if pane["cmd"] != "claude":
            continue
        sid, reason = resolve(pane, resurrect_ids)
        if sid is None:
            print(
                f"warning: {pane['session']}:{pane['window']}.{pane['pane']} "
                f"({pane['wname']}) — {reason}",
                file=sys.stderr,
            )
        elif args.verbose:
            print(
                f"{pane['session']}:{pane['window']}.{pane['pane']} "
                f"({pane['wname']}) -> {sid}  [{reason}]",
                file=sys.stderr,
            )
        rows.append(
            dict(
                tmux_session=pane["session"],
                window_number=pane["window"],
                pane_index=pane["pane"],
                window_name=pane["wname"],
                claude_session=sid or "",
            )
        )

    with open(args.out, "w", newline="") as f:
        writer = csv.DictWriter(
            f,
            fieldnames=[
                "tmux_session",
                "window_number",
                "pane_index",
                "window_name",
                "claude_session",
            ],
        )
        writer.writeheader()
        writer.writerows(rows)

    print(f"wrote {len(rows)} pane(s) to {args.out}")


if __name__ == "__main__":
    main()
