#!/usr/bin/env python3
"""Declarative wrapper for managing custom systemd services.

Source of truth: ~/.config/svc/services.toml
Usage: svc sync | diff | list | edit | start|stop|restart|status|update <name> | logs <name> [...]

sudo=true entries become system-level units (/etc/systemd/system), run as
root. sudo=false entries become systemd --user units under the given
`user`'s own session (~/.config/systemd/user), no root needed to manage.
"""
import argparse
import collections
import os
import pwd
import shlex
import shutil
import subprocess
import sys
import time
import tomllib
from pathlib import Path

SYSTEM_UNIT_DIR = Path("/etc/systemd/system")
MARKER = "# Managed by svc — do not edit directly"

DEFAULT_PATH = (
    "/home/linuxbrew/.linuxbrew/bin:/home/linuxbrew/.linuxbrew/sbin:"
    "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
)

CONFIG_HEADER_END = "# ---- end of svc header (managed by `svc edit`, do not edit above) ----\n"
CONFIG_HEADER = """\
# svc services config
#
# Fields per [service.<name>]:
#   path     (required) working directory of the service
#   command  (required) command to run, e.g. "node server.js"
#   args     (optional) extra arguments appended to `command`; either a
#                       string ("--port 8080") or a list (["--port", "8080"])
#   sudo     (optional) false (default) -> systemd --user unit under `user`,
#                       no root needed to manage it
#                       true -> system-level unit, runs as root
#   user     (optional) owner of the user unit; defaults to whoever owns
#                       this file
#
# Example:
# [service.myapp]
# path = "/home/kj/apps/myapp"
# command = "node server.js"
# args = "--port 8080"
# sudo = false
# user = "kj"
""" + CONFIG_HEADER_END + "\n"

Removal = collections.namedtuple("Removal", "name kind user")


def real_user():
    return os.environ.get("SUDO_USER") or os.environ.get("USER") or pwd.getpwuid(os.getuid()).pw_name


def real_home():
    user = real_user()
    try:
        return Path(pwd.getpwnam(user).pw_dir)
    except KeyError:
        return Path.home()


def config_path():
    return real_home() / ".config" / "svc" / "services.toml"


def ensure_root():
    if os.geteuid() != 0:
        os.execvp("sudo", ["sudo", sys.executable, os.path.abspath(__file__)] + sys.argv[1:])


def load_config(path):
    if not path.exists():
        return {}
    with open(path, "rb") as f:
        data = tomllib.load(f)
    return data.get("service", {})


def entry_user(entry):
    return entry.get("user") or real_user()


def system_unit_path(name):
    return SYSTEM_UNIT_DIR / f"svc-{name}.service"


def user_unit_dir(user):
    return Path(pwd.getpwnam(user).pw_dir) / ".config" / "systemd" / "user"


def user_unit_path(user, name):
    return user_unit_dir(user) / f"svc-{name}.service"


def unit_path_for(name, entry):
    if entry.get("sudo", False):
        return system_unit_path(name)
    return user_unit_path(entry_user(entry), name)


def generate_unit(name, entry):
    path = entry["path"]
    command = entry["command"]
    extra = entry.get("args", "")
    if extra:
        command += " " + (shlex.join(extra) if isinstance(extra, list) else extra)
    command = command.replace("'", "'\"'\"'")
    sudo = entry.get("sudo", False)
    if sudo:
        # Mirrors what running `sudo <command>` as the real user would set,
        # in case the service inspects SUDO_USER (e.g. to find that user's home).
        identity_line = f"Environment=SUDO_USER={entry_user(entry)}\n"
        wanted_by = "multi-user.target"
    else:
        identity_line = ""  # user units always run as their own owner
        wanted_by = "default.target"
    return (
        f"{MARKER}\n"
        f"[Unit]\n"
        f"Description=svc: {name}\n"
        f"After=network.target\n"
        f"\n"
        f"[Service]\n"
        f"Type=simple\n"
        f"WorkingDirectory={path}\n"
        f"ExecStart=/bin/bash -c '{command}'\n"
        f"Restart=on-failure\n"
        f"RestartSec=5\n"
        f"{identity_line}"
        f"Environment=PATH={DEFAULT_PATH}\n"
        f"\n"
        f"[Install]\n"
        f"WantedBy={wanted_by}\n"
    )


def existing_marked_units(unit_dir):
    names = set()
    if not unit_dir.exists():
        return names
    for p in unit_dir.glob("svc-*.service"):
        try:
            text = p.read_text()
        except OSError:
            continue
        if text.startswith(MARKER):
            names.add(p.stem[len("svc-"):])
    return names


def write_as_user(path, text, user):
    pw = pwd.getpwnam(user)
    home = Path(pw.pw_dir)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text)
    os.chown(path, pw.pw_uid, pw.pw_gid)
    d = path.parent
    while d != home and str(d).startswith(str(home)):
        os.chown(d, pw.pw_uid, pw.pw_gid)
        d = d.parent


def user_systemctl(user, *args, capture=False):
    uid = pwd.getpwnam(user).pw_uid
    if os.getuid() == uid:
        cmd = ["systemctl", "--user", *args]
        env = os.environ.copy()
        env["XDG_RUNTIME_DIR"] = f"/run/user/{uid}"
    else:
        cmd = ["sudo", "-u", user, "env", f"XDG_RUNTIME_DIR=/run/user/{uid}", "systemctl", "--user", *args]
        env = None
    return subprocess.run(cmd, env=env, capture_output=capture, text=True, check=False)


def ensure_linger(user):
    result = subprocess.run(
        ["loginctl", "show-user", user, "--property=Linger"], capture_output=True, text=True
    )
    if result.stdout.strip() != "Linger=yes":
        subprocess.run(["loginctl", "enable-linger", user], check=False)


def plan(config):
    to_add, to_update, unchanged = [], [], []
    for name, entry in config.items():
        text = generate_unit(name, entry)
        up = unit_path_for(name, entry)
        if not up.exists():
            to_add.append(name)
        elif up.read_text() != text:
            to_update.append(name)
        else:
            unchanged.append(name)

    to_remove = []
    desired_system = {n for n, e in config.items() if e.get("sudo", False)}
    for n in existing_marked_units(SYSTEM_UNIT_DIR) - desired_system:
        to_remove.append(Removal(n, "system", None))

    users = {entry_user(e) for e in config.values() if not e.get("sudo", False)}
    users.add(real_user())
    for u in users:
        desired_for_user = {
            n for n, e in config.items() if not e.get("sudo", False) and entry_user(e) == u
        }
        for n in existing_marked_units(user_unit_dir(u)) - desired_for_user:
            to_remove.append(Removal(n, "user", u))

    return sorted(to_add), sorted(to_update), to_remove, sorted(unchanged)


def cmd_diff(args):
    config = load_config(config_path())
    to_add, to_update, to_remove, unchanged = plan(config)
    remove_desc = [f"{r.name} ({r.kind}{', ' + r.user if r.user else ''})" for r in to_remove]
    print(f"Would add:     {to_add or 'none'}")
    print(f"Would update:  {to_update or 'none'}")
    print(f"Would remove:  {remove_desc or 'none'}")
    print(f"Unchanged:     {unchanged or 'none'}")


def cmd_sync(args):
    ensure_root()
    cfg_path = config_path()
    config = load_config(cfg_path)
    if not config:
        print(f"No services defined in {cfg_path}. Run 'svc edit' to add some.")
        return

    to_add, to_update, to_remove, unchanged = plan(config)
    changed_system = False
    changed_users = set()

    if to_remove:
        print("The following services are no longer in the config and will be stopped/removed:")
        for r in to_remove:
            print(f"  - {r.name} ({r.kind}{', ' + r.user if r.user else ''})")
        resp = input("Proceed with removal? [y/N] ").strip().lower()
        if resp == "y":
            for r in to_remove:
                if r.kind == "system":
                    subprocess.run(["systemctl", "disable", "--now", f"svc-{r.name}"], check=False)
                    system_unit_path(r.name).unlink(missing_ok=True)
                    changed_system = True
                else:
                    user_systemctl(r.user, "disable", "--now", f"svc-{r.name}")
                    user_unit_path(r.user, r.name).unlink(missing_ok=True)
                    changed_users.add(r.user)
        else:
            print("Skipping removals.")
            to_remove = []

    for name in to_add + to_update:
        entry = config[name]
        text = generate_unit(name, entry)
        if entry.get("sudo", False):
            system_unit_path(name).write_text(text)
            changed_system = True
        else:
            user = entry_user(entry)
            write_as_user(user_unit_path(user, name), text, user)
            changed_users.add(user)

    if changed_system:
        subprocess.run(["systemctl", "daemon-reload"], check=True)
    for user in changed_users:
        ensure_linger(user)
        user_systemctl(user, "daemon-reload")

    for name in to_add:
        entry = config[name]
        if entry.get("sudo", False):
            subprocess.run(["systemctl", "enable", "--now", f"svc-{name}"], check=False)
        else:
            user_systemctl(entry_user(entry), "enable", "--now", f"svc-{name}")
    for name in to_update:
        entry = config[name]
        if entry.get("sudo", False):
            subprocess.run(["systemctl", "restart", f"svc-{name}"], check=False)
        else:
            user_systemctl(entry_user(entry), "restart", f"svc-{name}")

    print(f"Added:     {to_add or 'none'}")
    print(f"Updated:   {to_update or 'none'}")
    print(f"Removed:   {[r.name for r in to_remove] or 'none'}")
    print(f"Unchanged: {unchanged or 'none'}")


def cmd_list(args):
    config = load_config(config_path())
    if not config:
        print(f"No services defined in {config_path()}. Run 'svc edit' to add some.")
        return
    to_add, to_update, to_remove, unchanged = plan(config)
    in_sync_names = set(unchanged)
    print(f"{'NAME':<20} {'MODE':<8} {'USER':<10} {'ACTIVE':<10} {'ENABLED':<10} {'IN SYNC'}")
    for name, entry in sorted(config.items()):
        sudo = entry.get("sudo", False)
        user = entry_user(entry)
        mode = "system" if sudo else "user"
        if sudo:
            active = subprocess.run(
                ["systemctl", "is-active", f"svc-{name}"], capture_output=True, text=True
            ).stdout.strip() or "unknown"
            enabled = subprocess.run(
                ["systemctl", "is-enabled", f"svc-{name}"], capture_output=True, text=True
            ).stdout.strip() or "unknown"
        else:
            active = user_systemctl(user, "is-active", f"svc-{name}", capture=True).stdout.strip() or "unknown"
            enabled = user_systemctl(user, "is-enabled", f"svc-{name}", capture=True).stdout.strip() or "unknown"
        in_sync = "yes" if name in in_sync_names else "no"
        print(f"{name:<20} {mode:<8} {user:<10} {active:<10} {enabled:<10} {in_sync}")
    if to_remove:
        remove_desc = [f"{r.name}({r.kind})" for r in to_remove]
        print(f"\nManaged units with no config entry (run 'svc sync' to remove): {remove_desc}")


def ensure_config_header(path):
    text = path.read_text() if path.exists() else ""
    if text.startswith("# svc services config") and CONFIG_HEADER_END in text:
        text = text.split(CONFIG_HEADER_END, 1)[1].lstrip("\n")
    new = CONFIG_HEADER + text
    if new != text:
        path.write_text(new)


def cmd_edit(args):
    path = config_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    ensure_config_header(path)
    editor = os.environ.get("EDITOR") or next(
        (e for e in ("nvim", "vim", "nano") if shutil.which(e)), None
    )
    if not editor:
        print(f"No editor found (checked $EDITOR, nvim, vim, nano). Config is at {path}")
        return
    os.execvp(editor, [editor, str(path)])


def cmd_passthrough(args):
    config = load_config(config_path())
    entry = config.get(args.name)
    if entry is None:
        print(f"Unknown service: {args.name} (not in {config_path()})")
        sys.exit(1)
    if entry.get("sudo", False):
        if args.action in ("start", "stop", "restart"):
            ensure_root()
        result = subprocess.run(["systemctl", args.action, f"svc-{args.name}"])
    else:
        result = user_systemctl(entry_user(entry), args.action, f"svc-{args.name}")
    sys.exit(result.returncode)


def cmd_update(args):
    config = load_config(config_path())
    entry = config.get(args.name)
    if entry is None:
        print(f"Unknown service: {args.name} (not in {config_path()})")
        sys.exit(1)
    path = entry["path"]
    user = entry_user(entry)
    cmd = ["git", "-C", path, "pull"]
    if os.getuid() != pwd.getpwnam(user).pw_uid:
        cmd = ["sudo", "-u", user] + cmd
    result = subprocess.run(cmd)
    if result.returncode != 0:
        sys.exit(result.returncode)
    print(f"Restarting {args.name}...")
    since = time.strftime("%Y-%m-%d %H:%M:%S")
    args.action = "restart"
    try:
        cmd_passthrough(args)
    except SystemExit as e:
        if e.code == 0:
            print(f"Restarted {args.name}, startup logs:")
            time.sleep(2)
            jcmd = ["journalctl"] + ([] if entry.get("sudo", False) else ["--user"])
            subprocess.run(jcmd + ["-u", f"svc-{args.name}", "--since", since, "--no-pager"])
        raise


def cmd_logs(args):
    config = load_config(config_path())
    entry = config.get(args.name)
    if entry is None:
        print(f"Unknown service: {args.name} (not in {config_path()})")
        sys.exit(1)
    cmd = ["journalctl"]
    if not entry.get("sudo", False):
        cmd.append("--user")
    cmd += ["-u", f"svc-{args.name}", "-n", "100"]
    if not args.no_follow:
        cmd.append("-f")
    cmd.extend(args.extra)
    result = subprocess.run(cmd)
    sys.exit(result.returncode)


def main():
    parser = argparse.ArgumentParser(prog="svc")
    sub = parser.add_subparsers(dest="cmd")

    sub.add_parser("sync", help="reconcile systemd units to match the config").set_defaults(func=cmd_sync)
    sub.add_parser("diff", help="show what sync would change").set_defaults(func=cmd_diff)
    sub.add_parser("list", help="list configured services and their status").set_defaults(func=cmd_list)
    sub.add_parser("edit", help="open the config file in an editor").set_defaults(func=cmd_edit)

    for action in ("start", "stop", "restart", "status"):
        p = sub.add_parser(action, help=f"systemctl {action} on a managed service")
        p.add_argument("name")
        p.set_defaults(func=cmd_passthrough, action=action)

    p = sub.add_parser("update", help="git pull in a managed service's folder, then restart it")
    p.add_argument("name")
    p.set_defaults(func=cmd_update)

    p = sub.add_parser("logs", help="tail logs for a managed service")
    p.add_argument("name")
    p.add_argument("--no-follow", action="store_true")
    p.add_argument("extra", nargs=argparse.REMAINDER)
    p.set_defaults(func=cmd_logs)

    args = parser.parse_args()
    if not args.cmd:
        parser.print_help()
        sys.exit(0)
    args.func(args)


if __name__ == "__main__":
    main()
