{
  "manifest_version": 3,
  "name": "Home",
  "version": "3.2",
  "description": "New tab page built from your bookmarks, with pinning.",
  "permissions": [
    "bookmarks",
    "favicon",
    "storage",
    "activeTab"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Pin to Home",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
