{
  "manifest_version": 3,
  "name": "Home",
  "version": "3.1",
  "description": "New tab page built from your bookmarks, with pinning.",
  "permissions": ["bookmarks", "favicon", "storage", "activeTab"],
  "chrome_url_overrides": { "newtab": "index.html" },
  "icons": {
    "16": "icons/blank16.png",
    "32": "icons/blank32.png",
    "48": "icons/blank48.png",
    "128": "icons/blank128.png"
  },
  "action": {
    "default_title": "Pin to Home",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/pin16.png", "32": "icons/pin32.png" }
  }
}
