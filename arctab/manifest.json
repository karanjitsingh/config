{
  "manifest_version": 3,
  "name": "ArcTab",
  "version": "4.5",
  "key": "",
  "description": "New tab page built from your bookmarks, with pinning.",
  "permissions": [
    "bookmarks",
    "favicon",
    "storage",
    "activeTab",
    "history",
    "tabs",
    "management",
    "search",
    "scripting",
    "userScripts",
    "declarativeNetRequestWithHostAccess",
    "declarativeNetRequestFeedback",
    "offscreen"
  ],
  "chrome_url_overrides": {
    "newtab": "src/newtab/index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Pin to ArcTab",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "commands": {
    "open-search": {
      "suggested_key": {
        "default": "Alt+T",
        "mac": "MacCtrl+T"
      },
      "description": "Search over the current page (like Arc's new tab)"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/overlay/overlay.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
